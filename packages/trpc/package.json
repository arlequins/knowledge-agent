{
  "name": "@arlequins/trpc",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./src/client.ts"
    },
    "./agent-completion": {
      "types": "./dist/application/agent-completion.d.ts",
      "default": "./src/application/agent-completion.ts"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "biome format .",
    "lint": "biome lint .",
    "test": "pnpm with-env vitest run",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "with-env": "dotenv -e ../../.env --"
  },
  "dependencies": {
    "@arlequins/agent-bedrock": "workspace:*",
    "@arlequins/agent-core": "workspace:*",
    "@arlequins/agent-ollama": "workspace:*",
    "@arlequins/agent-openai": "workspace:*",
    "@arlequins/auth": "workspace:*",
    "@arlequins/db-backbone": "workspace:*",
    "@arlequins/env": "workspace:*",
    "@arlequins/logger": "workspace:*",
    "@arlequins/service": "workspace:*",
    "@arlequins/validators": "workspace:*",
    "@aws-sdk/client-bedrock-runtime": "catalog:",
    "@aws-sdk/client-s3": "catalog:",
    "@trpc/server": "catalog:",
    "drizzle-orm": "catalog:",
    "superjson": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@arlequins/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
