{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["sources"],
  "properties": {
    "$schema": { "type": "string" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "package",
          "allowedHost",
          "versionPolicy",
          "pages"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "package": { "type": "string", "minLength": 1 },
          "allowedHost": { "type": "string", "minLength": 1 },
          "versionPolicy": { "enum": ["latest", "latest-major"] },
          "pages": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            }
          }
        }
      }
    }
  }
}
